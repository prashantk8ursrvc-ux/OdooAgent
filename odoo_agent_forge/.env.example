# Copy to odoo_agent_forge/.env and fill in. Never commit the real file.
#
# Only the generation stage needs these - the model that comes out the far end
# runs entirely locally and calls nothing.
#
# Several numbered keys are supported and rotated when one hits a rate limit,
# which is what makes an overnight generation run survive unattended. One key is
# enough to start.

NVIDIA_API_KEY=
NVIDIA_API_KEY2=
NVIDIA_API_KEY3=

OPENROUTER_API_KEY=
OPENROUTER_API_KEY1=
OPENROUTER_API_KEY2=
